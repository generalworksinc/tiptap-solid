{
  "name": "@generalworks/tiptap-solid",
  "version": "1.2.0",
  "description": "TipTap v2 integration for Solid.js",
  "type": "module",
  "private": false,
  "sideEffects": false,
  "scripts": {
    "build": "tsup && vite build --config vite.solid2.config.ts",
    "prepublish": "bun run build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.solid2.json --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:fix-unsafe": "biome check --write --unsafe ."
  },
  "source": "src/index.ts",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "src2"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "solid": "./dist/index.jsx",
      "default": "./dist/index.js"
    },
    "./solid2": {
      "types": "./dist/solid2/index.d.ts",
      "solid": "./src2/index.ts",
      "default": "./dist/solid2/index.js"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "solid": "./dist/*/index.jsx",
      "default": "./dist/*/index.js"
    },
    "./src/*": "./src/*"
  },
  "keywords": [
    "tiptap",
    "wysiwyg",
    "solid",
    "solidjs"
  ],
  "license": "MIT",
  "dependencies": {
    "@floating-ui/dom": "^1.6.0",
    "@tiptap/extension-bubble-menu": "3.4.2",
    "@tiptap/extension-floating-menu": "3.4.2",
    "nanoid": "^5.0.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@solidjs/vite-plugin": "3.0.0-next.28",
    "@solidjs/web": "2.0.0-rc.0",
    "@tiptap/core": "3.4.2",
    "@tiptap/pm": "3.4.2",
    "esbuild-plugin-solid": "^0.6.0",
    "solid-js": "^1.8.20",
    "solid-js-v2": "npm:solid-js@2.0.0-rc.0",
    "tsup": "^8.5.0",
    "typescript": "^5.5.4",
    "vite": "^8.1.5",
    "vite-plugin-dts": "^4.5.4"
  },
  "peerDependencies": {
    "@tiptap/core": "^3.0.0",
    "@tiptap/pm": "^3.0.0",
    "solid-js": ">=1.8 <2 || >=2.0.0-0"
  }
}
