{
  "name": "@generalworks/tiptap-solid",
  "version": "2.0.0",
  "description": "TipTap v3 integration for Solid 2",
  "type": "module",
  "private": false,
  "sideEffects": false,
  "scripts": {
    "build": "vite build",
    "prepublish": "bun run build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:fix-unsafe": "biome check --write --unsafe ."
  },
  "source": "src/index.ts",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "solid": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./solid2": {
      "types": "./dist/index.d.ts",
      "solid": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "keywords": [
    "tiptap",
    "wysiwyg",
    "solid",
    "solidjs"
  ],
  "license": "MIT",
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@tiptap/extension-bubble-menu": "^3.35.0",
    "@tiptap/extension-floating-menu": "^3.35.0",
    "nanoid": "^6.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@solidjs/vite-plugin": "3.0.1",
    "@solidjs/web": "2.0.4",
    "@tiptap/core": "3.35.0",
    "@tiptap/extension-bubble-menu": "3.35.0",
    "@tiptap/extension-floating-menu": "3.35.0",
    "@tiptap/pm": "3.35.0",
    "solid-js": "2.0.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2"
  },
  "peerDependencies": {
    "@solidjs/web": "^2.0.0",
    "@tiptap/core": "^3.0.0",
    "@tiptap/pm": "^3.0.0",
    "solid-js": "^2.0.0"
  }
}
