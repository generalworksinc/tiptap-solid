{
  "name": "@generalworks/tiptap-solid",
  "version": "1.2.1",
  "description": "TipTap v2 integration for Solid.js",
  "type": "module",
  "private": false,
  "sideEffects": false,
  "scripts": {
    "build": "tsup && vite build --config vite.solid2.config.ts",
    "prepublish": "bun run build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.solid2.json --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:fix-unsafe": "biome check --write --unsafe ."
  },
  "source": "src/index.ts",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "src2"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "solid": "./dist/index.jsx",
      "default": "./dist/index.js"
    },
    "./solid2": {
      "types": "./dist/solid2/index.d.ts",
      "solid": "./src2/index.ts",
      "default": "./dist/solid2/index.js"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "solid": "./dist/*/index.jsx",
      "default": "./dist/*/index.js"
    },
    "./src/*": "./src/*"
  },
  "keywords": [
    "tiptap",
    "wysiwyg",
    "solid",
    "solidjs"
  ],
  "license": "MIT",
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@tiptap/extension-bubble-menu": "^3.35.0",
    "@tiptap/extension-floating-menu": "^3.35.0",
    "nanoid": "^6.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@solidjs/vite-plugin": "3.0.1",
    "@solidjs/web": "2.0.4",
    "@tiptap/core": "3.35.0",
    "@tiptap/extension-bubble-menu": "3.35.0",
    "@tiptap/extension-floating-menu": "3.35.0",
    "@tiptap/pm": "3.35.0",
    "esbuild-plugin-solid": "^0.6.0",
    "solid-js": "^1.9.20",
    "solid-js-v2": "npm:solid-js@2.0.4",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2"
  },
  "peerDependencies": {
    "@tiptap/core": "^3.0.0",
    "@tiptap/pm": "^3.0.0",
    "solid-js": ">=1.8 <2 || >=2.0.0",
    "@solidjs/web": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@solidjs/web": {
      "optional": true
    }
  }
}
